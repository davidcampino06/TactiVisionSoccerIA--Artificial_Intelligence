# Model: YOLO26n (default) | YOLO11n | RT-DETR-l (RT-DETR only with MODEL_RUNTIME=ultralytics)
MODEL_NAME=YOLO26n
# onnx (light, recommended) | ultralytics (requires requirements-eval.txt / PyTorch)
MODEL_RUNTIME=onnx
MODEL_DIR=models
MODEL_AUTO_DOWNLOAD=true
LOAD_MODEL_ON_STARTUP=true
TRACKER_NAME=ByteTrack

CONFIDENCE_THRESHOLD=0.25
BALL_CONFIDENCE_THRESHOLD=0.15
FRAME_STRIDE=3
MAX_FRAMES=300
MAX_UPLOAD_SIZE_MB=200
TEMP_DIR=tmp

# Shared secret: the Backend sends it in the X-API-Key header. Use a long random value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=
